    <!-- Model instructions dialog -->
    <string name="model_help_title">Install the speech model</string>
    <string name="model_help_copy_path">Copy path</string>
    <string name="model_help_whisper">FlowKey needs the multilingual Whisper model (all four files):\n\n1. On a computer, download:\nhttps://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-whisper-base.tar.bz2\n(or sherpa-onnx-whisper-small.tar.bz2 for better quality — do NOT use a \".en\" variant)\n\n2. Extract it and copy these three files:\n• *-encoder.int8.onnx\n• *-decoder.int8.onnx\n• *-tokens.txt\n\n3. Connect the phone via USB and place them in:\n%1$s\n\n4. Come back and tap Re-check.\n\nFull details: MODELS.md in the project folder.</string>
    <string name="model_help_zipformer">Streaming mode needs the English streaming Zipformer model:\n\n1. On a computer, download:\nhttps://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-streaming-zipformer-en-2023-06-26.tar.bz2\n\n2. Extract and copy these four files:\n• encoder-*.int8.onnx\n• decoder-*.onnx\n• joiner-*.int8.onnx\n• tokens.txt\n\n3. Connect the phone via USB and place them in:\n%1$s\n\n4. Come back and tap Re-check.\n\nFull details: MODELS.md in the project folder.</string>
