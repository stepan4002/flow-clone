<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp">

    <!-- Status / partial-text line with optional action chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/status_loading"
            android:textColor="@color/key_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/actionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_key"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="@string/action_open_setup"
            android:textColor="@color/flowkey_accent_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Main row: globe/settings | mic | backspace/enter -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="124dp">

        <LinearLayout
            android:id="@+id/leftColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/globeButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_key"
                android:contentDescription="@string/cd_globe"
                android:scaleType="centerInside"
                android:src="@drawable/ic_globe" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_key"
                android:contentDescription="@string/cd_settings"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_mic"
            android:contentDescription="@string/cd_mic"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />

        <LinearLayout
            android:id="@+id/rightColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/backspaceButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_key"
                android:contentDescription="@string/cd_backspace"
                android:scaleType="centerInside"
                android:src="@drawable/ic_backspace" />

            <ImageButton
                android:id="@+id/enterButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_key"
                android:contentDescription="@string/cd_enter"
                android:scaleType="centerInside"
                android:src="@drawable/ic_enter" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom row: language + space -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/langButton"
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_key"
            android:contentDescription="@string/cd_language"
            android:gravity="center"
            android:text="@string/lang_auto"
            android:textColor="@color/key_icon"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spaceButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_key"
            android:gravity="center"
            android:text="@string/space_label"
            android:textColor="@color/key_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
