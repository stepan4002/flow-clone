<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer (Android 12+). Same exclusions as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="model/" />
        <exclude domain="file" path="hotwords/" />
        <exclude domain="sharedpref" path="flowkey_runtime.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="model/" />
        <exclude domain="file" path="hotwords/" />
        <exclude domain="sharedpref" path="flowkey_runtime.xml" />
    </device-transfer>
</data-extraction-rules>
